{
  "version": 1,
  "author": "Gurirath",
  "editor": "wokwi",
  "parts": [
    {
      "type": "wokwi-esp32-devkit-v1",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot1",
      "top": 300,
      "left": -220,
      "attrs": { "label": "SEAT SENSOR" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot2",
      "top": 300,
      "left": 0,
      "attrs": { "label": "GPS POSITION" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn1",
      "top": 300,
      "left": 250,
      "attrs": { "color": "green", "label": "FACE SCAN", "bounce": "0" }
    },
    {
      "type": "wokwi-slide-switch",
      "id": "sw1",
      "top": 300,
      "left": 400,
      "attrs": { "value": "1", "bounce": "0", "label": "WIFI" }
    },
    {
      "type": "wokwi-slide-switch",
      "id": "sw2",
      "top": 300,
      "left": 500,
      "attrs": { "value": "1", "bounce": "0", "label": "DOOR" }
    },
    {
      "type": "wokwi-ds18b20",
      "id": "temp1",
      "top": 300,
      "left": 650,
      "attrs": { "temperature": "36.7" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 230,
      "left": 650,
      "attrs": { "value": "4700" }
    }
  ],
  "connections": [
    ["esp:TX0", "$serialMonitor:RX", "", []],
    ["esp:RX0", "$serialMonitor:TX", "", []],

    ["pot1:SIG", "esp:D34", "green", []],
    ["pot1:VCC", "esp:3V3", "red", []],
    ["pot1:GND", "esp:GND.1", "black", []],

    ["pot2:SIG", "esp:D35", "blue", []],
    ["pot2:VCC", "esp:3V3", "red", []],
    ["pot2:GND", "esp:GND.2", "black", []],

    ["btn1:1.l", "esp:D4", "green", []],
    ["btn1:2.l", "esp:GND.3", "black", []],

    ["sw1:2", "esp:D5", "orange", []],
    ["sw1:1", "esp:GND.4", "black", []],

    ["sw2:2", "esp:D19", "purple", []],
    ["sw2:1", "esp:GND.6", "black", []],

    ["temp1:VCC", "esp:3V3", "red", []],
    ["temp1:DQ", "r1:1", "blue", []],
    ["r1:2", "esp:3V3", "red", []],
    ["temp1:GND", "esp:GND.5", "black", []]
  ],
  "serialMonitor": {
    "display": "terminal",
    "collapse": false,
    "convertEol": false,
    "newline": "lf"
  }
}
